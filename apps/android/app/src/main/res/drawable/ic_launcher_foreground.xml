<?xml version="1.0" encoding="utf-8"?>
<!-- Logo da capivara (logo/fina_logo_capivara.png) recuado pra caber na zona
     segura (66dp centrais) do icone adaptativo — a imagem ja e um circulo
     quase sem margem, entao sem o recuo a mascara do launcher corta o anel
     dourado em formatos nao-circulares (squircle, quadrado arredondado). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20%"
    android:insetTop="20%"
    android:insetRight="20%"
    android:insetBottom="20%">
    <bitmap android:src="@drawable/fina_capivara" android:gravity="center" />
</inset>
